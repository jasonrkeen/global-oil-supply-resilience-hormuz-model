# Obtain a free key from https://www.eia.gov/opendata/register.php
EIA_API_KEY=replace_with_your_key

# Set to 0 only when you deliberately want to skip live collection.
ENABLE_LIVE_DATA=1

# 0 preserves the sourced scenario assumption; 1 uses the latest observed Brent
# price as the model's starting price and records the change in baseline_audit.csv.
USE_LIVE_BRENT_BASELINE=0
